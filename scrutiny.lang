[zh-cn]
name = "Scrutiny 磁盘健康面板"
auth = "ericbyz"
descript = "TNAS 硬盘 S.M.A.R.T. 健康仪表盘:每日自动采集全部硬盘 SMART 属性,历史数据存于本地 SQLite,浏览器打开 http://<NAS>:18232 查看各盘健康度与老化趋势。上游二进制原样封装(MIT),需要 smartctl(TOS 出厂自带);采集计划默认每日 02:30,可改 /etc/scrutiny/scrutiny.yaml。"
note = "1. 将上游 AnalogJ/scrutiny(MIT)原样封装为 TOS 应用。"

[zh-hk]
name = "Scrutiny 磁盤健康面板"
auth = "ericbyz"
descript = "TNAS 硬盤 S.M.A.R.T. 健康儀表盤:每日自動採集全部硬盤 SMART 屬性,歷史數據存於本地 SQLite,瀏覽器打開 http://<NAS>:18232 查看各盤健康度與老化趨勢。上游二進制原樣封裝(MIT),需要 smartctl(TOS 出廠自帶);採集計劃默認每日 02:30,可改 /etc/scrutiny/scrutiny.yaml。"
note = "1. 将上游 AnalogJ/scrutiny(MIT)原样封装为 TOS 应用。"

[en-us]
name = "Scrutiny Disk Health"
auth = "ericbyz"
descript = "S.M.A.R.T. disk health dashboard for the TNAS: collects SMART attributes daily, keeps the full history in SQLite and shows failure-risk trends at http://<NAS>:18232. Packaged unmodified from upstream AnalogJ/scrutiny (MIT). Requires smartctl (included in stock TOS)."
note = "1. Repackaged upstream AnalogJ/scrutiny (MIT) unmodified for TOS."

